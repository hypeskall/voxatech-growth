NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local administration only. Never deploy this token or prefix it NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
APP_URL=
# Optional providers. Unconfigured services are shown as Neconfigurat.
GEMINI_API_KEY=
AI_PROVIDER=
DEFAULT_AUTOMATION_MODEL=
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INTERNAL_TEST_EMAIL=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
# Legacy fallback only. Prefer RESEND_FROM_EMAIL.
EMAIL_FROM=
EMAIL_DELIVERY_MODE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOXA_VOICE_ID=
ELEVENLABS_PATIENT_VOICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
CRON_SECRET=
VOXA_ADMIN_EMAIL=
# Autopilot discovery (server only). Configure a Brave plan with storage rights.
BRAVE_SEARCH_API_KEY=
# Dedicated scheduler token; provision with scripts/configure-autopilot-scheduler.mjs
AUTOPILOT_CRON_SECRET=

# Replies go to the existing mailbox; does not configure mailbox hosting.
EMAIL_REPLY_TO=contact@voxatech.ro

# Google OAuth Web client for Gmail sending and the shared reply inbox.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# 64 hex characters (32 random bytes). Server only; retain it across deploys.
GMAIL_TOKEN_ENCRYPTION_KEY=
