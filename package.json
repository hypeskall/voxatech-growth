{
  "name": "voxa-growth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "db:verify": "node --env-file=.env.local scripts/verify.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "auth:configure": "node --env-file=.env.local scripts/configure-auth.mjs",
    "dry-run:full": "node --env-file=.env.local scripts/dry-run-flow.mjs",
    "ai:test": "node --env-file=.env.local scripts/ai-smoke-test.mjs",
    "ai:evaluate-real": "node --env-file=.env.local scripts/evaluate-real-leads.mjs",
    "ai:evaluate-batch": "node --env-file=.env.local scripts/evaluate-real-leads-batch.mjs",
    "format": "prettier --write src scripts tests *.mjs *.json"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "music-metadata": "^11.16.1",
    "next": "latest",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.29.0",
    "server-only": "latest",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.9",
    "typescript": "latest"
  },
  "type": "module"
}
